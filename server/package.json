{
  "name": "@chessspeak/server",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-only",
  "scripts": {
    "build": "pnpm --filter @chessspeak/shared build && nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
