{
  "name": "@chessspeak/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/cjs/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "require": "./dist/cjs/index.js",
      "default": "./src/index.ts"
    },
    "./tokens.css": "./styles/tokens.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/mark-cjs.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
