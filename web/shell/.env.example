# Public settings of the shell (they end up in the browser as config.js). Never put secrets here.
# Only keys that start with PUBLIC_ are copied. Copy to web/shell/.env to override.
PUBLIC_API_URL=
PUBLIC_AGENT_URL=http://127.0.0.1:8765
# how long the shell waits for a microfrontend before showing "<name> no disponible"
PUBLIC_MF_TIMEOUT_MS=5000
