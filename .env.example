# Copy to .env (git-ignored). `pnpm --filter @chessspeak/spike-whisper-local download` fills the WHISPER_* paths.

# whisper.cpp binary and models (stay outside git: whisper/ and models/ are ignored)
WHISPER_SERVER_PATH=
WHISPER_MODEL_BASE=
WHISPER_MODEL_SMALL=
# model the HTTP agent loads: base | small
WHISPER_MODEL=base
WHISPER_LANGUAGE=es
# optional vocabulary prompt for the agent (the benchmark has its own default)
WHISPER_PROMPT=
WHISPER_INTERNAL_PORT=8791

# local HTTP agent
AGENT_HOST=127.0.0.1
AGENT_PORT=8765
AGENT_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
MAX_BODY_BYTES=10485760

# worker pool of the local agent; commented values are the defaults (ADR 10)
# 1 worker is the fastest for the real use, which sends one request at a time
# LB_WORKERS=1
# default: the machine's hardware threads divided by LB_WORKERS
# LB_THREADS_PER_WORKER=
# least-connections or round-robin
# LB_STRATEGY=least-connections
# LB_BASE_PORT=8801
# default: 4 per worker
# LB_QUEUE_MAX=
# LB_TIMEOUT_MS=15000

# gate applied before transcribing (fixed for the spike; do not tune on the test split)
MIN_DURATION_MS=300
MIN_RMS_DBFS=-50

# route names of the local agent
AGENT_HEALTH_PATH=/health
AGENT_TRANSCRIBE_PATH=/transcribe

# ---- server (NestJS) ----
# Never put real values in this file: copy it to .env (git-ignored) and fill your own.
PORT=3000
# origins allowed by CORS (HTTP and Socket.IO); add the public web origin when it exists
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
# how long a database connection may take; 1 s fits local databases, Neon and Atlas need more (docs/deploy.md)
# DB_CONNECT_TIMEOUT_MS=1000
# secret that signs guest tokens. No default: pnpm env:init generates a random one, and without it guests cannot sign in
GUEST_TOKEN_SECRET=
# requests per minute per IP allowed on POST /auth/guest (default 10)
# GUEST_AUTH_LIMIT_PER_MINUTE=10
# how long a player may stay disconnected from an active game before losing it (default 60000)
# ABANDON_TIMEOUT_MS=60000

# ---- local databases (docker compose up -d) ----
# The values below are EXAMPLES. Run `pnpm env:init` to copy this file to .env with random passwords.
# Ports are published only on 127.0.0.1. 55432 avoids a Postgres already installed on the host (5432).
POSTGRES_USER=chessspeak
POSTGRES_PASSWORD=change-me-pg
POSTGRES_DB=chessspeak
PG_PORT=55432
MONGO_INITDB_ROOT_USERNAME=chessspeak
MONGO_INITDB_ROOT_PASSWORD=change-me-mongo
MONGO_PORT=27017

# connection strings of the server (in production: Neon and Atlas, set in the host, never in git)
DATABASE_URL=postgresql://chessspeak:change-me-pg@127.0.0.1:55432/chessspeak
MONGO_URI=mongodb://chessspeak:change-me-mongo@127.0.0.1:27017/chessspeak?authSource=admin

# integration tests (pnpm test:integration) only run against localhost and databases that end in _test
DATABASE_URL_TEST=postgresql://chessspeak:change-me-pg@127.0.0.1:55432/chessspeak_test
MONGO_URI_TEST=mongodb://chessspeak:change-me-mongo@127.0.0.1:27017/chessspeak_test?authSource=admin
