# Copy to .env (git-ignored). `pnpm --filter @chessspeak/spike-whisper-local download` fills the WHISPER_* paths.

# whisper.cpp binary and models (stay outside git: whisper/ and models/ are ignored)
WHISPER_SERVER_PATH=
WHISPER_MODEL_BASE=
WHISPER_MODEL_SMALL=
# model the HTTP agent loads: base | small
WHISPER_MODEL=base
WHISPER_LANGUAGE=es
# optional vocabulary prompt for the agent (the benchmark has its own default)
WHISPER_PROMPT=
WHISPER_INTERNAL_PORT=8791

# local HTTP agent
AGENT_HOST=127.0.0.1
AGENT_PORT=8765
AGENT_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
MAX_BODY_BYTES=10485760

# gate applied before transcribing (fixed for the spike; do not tune on the test split)
MIN_DURATION_MS=300
MIN_RMS_DBFS=-50

# route names of the local agent
AGENT_HEALTH_PATH=/health
AGENT_TRANSCRIBE_PATH=/transcribe
