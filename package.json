{
  "name": "chessspeak",
  "private": true,
  "version": "0.0.0",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm typecheck && pnpm test",
    "metrics": "pnpm --filter @chessspeak/voice-parser metrics",
    "spike:build": "pnpm --filter @chessspeak/spike-web-speech build",
    "build:web": "node scripts/build-web.mjs",
    "serve:web": "node scripts/serve-web.mjs",
    "smoke:web": "node scripts/smoke-web.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
